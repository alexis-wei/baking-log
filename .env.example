# Baking log. Copy to .env.local for local dev, or set these in Vercel.
# Leave everything unset locally to use a SQLite file and local uploads in
# .baking-local/ (recommended: never point local dev at production data).

# Turso (logs, ingredients, recipes, timeline). Unset locally = .baking-local/baking.db
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Cloudflare R2 (photos, videos, ingredient images, recipe files). Unset locally = .baking-local/uploads/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket, e.g. https://pub-xxxx.r2.dev or a custom domain
R2_PUBLIC_URL=

# Editing passcode, plus a long random string used to sign the editor cookie
# (generate one with: openssl rand -base64 32)
BAKING_PASSCODE=
BAKING_SESSION_SECRET=
